# ============================================================
# 知研 KnowResearch — 环境变量模板
# 作用：列出所有需要的环境变量及其说明
# 用法：复制为 .env 后填入真实值
# 安全：此文件提交 git；.env 已被 .gitignore 排除，永不提交
# ============================================================

# ---- LLM（大语言模型）----
# DeepSeek API：生成与问答
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- VLM（视觉语言模型）----
# 作用：PDF 图表/图片转结构化文字
# 当前模型：qwen3.8-omni-flash（多模态，文本+视觉一体）
VLM_API_KEY=your-qwen-vl-api-key-here
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-omni-flash

# ---- Embedding（文本向量化）----
# 本地模型目录，首次运行自动下载到该路径
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_DIR=./models/embedding
EMBEDDING_DIMENSION=768

# ---- Reranker（重排序）----
# 本地模型目录，首次运行自动下载到该路径
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_MODEL_DIR=./models/reranker

# ---- 数据目录 ----
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INDEX_DIR=./data/index

# ---- 存储（MVP 阶段用 SQLite + 本地文件）----
DATABASE_URL=sqlite:///./data/knowresearch.db
POSTGRES_URL=postgresql+psycopg2://knowresearch:knowresearch@localhost:5432/knowresearch
FILE_STORAGE_DIR=./data/files

# ---- Redis（短期记忆 / 工作记忆热状态）----
REDIS_URL=redis://localhost:6379/0

# ---- PostgreSQL / Redis 容器（P1 Docker Compose）----
POSTGRES_DB=knowresearch
POSTGRES_USER=knowresearch
POSTGRES_PASSWORD=knowresearch
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- 演示模式 ----
# true 时使用 Mock Embedding / Reranker 和本地 Demo LLM，不依赖 GPU / API Key
DEMO_MODE=false

# ---- Agentic RAG（意图路由 + ReAct 慢路径，默认开启）----
# 开启后，复杂问题走 ReAct 多步循环；闲聊直答，简单问题仍走原 RAG 快路径
AGENT_ENABLED=true
# 是否启用六类意图路由；关闭则退化为「是否复杂」两档判断
AGENT_ROUTER_ENABLED=true
# ReAct 最大步数（Thought-Action-Observation 循环次数上限）
AGENT_MAX_STEPS=5
# 单次任务最多 LLM 调用次数（含最终决策）
AGENT_MAX_LLM_CALLS=8
# 单步 Observation 写入 scratchpad 的最大字符数（超出截断，防上下文膨胀）
AGENT_OBSERVATION_MAX_CHARS=300
# 单次工具执行的默认超时（秒）
AGENT_STEP_TIMEOUT_SECONDS=15
# 是否开启 CRAG 式检索质量反思；不足时写回 scratchpad 触发查询改写
AGENT_REFLECTION_ENABLED=true
# 检索质量反思通过阈值（0~1，越高越严格）
AGENT_REFLECTION_MIN_QUALITY=0.2

# ---- 图表摄取（方案一：图像描述化）----
# true 时摄入阶段调用 VLM 对论文配图生成文本描述；false 时只用图题+正文
FIGURE_VERBALIZE_ENABLED=false
# true 时查询阶段对命中的图片调用 VLM 解读并注入答案；false 时只用文本引用
FIGURE_READ_ENABLED=false
# 过滤小图片（logo/装饰）的最小边长，单位磅
FIGURE_MIN_SIDE=30
# 单篇文档最多描述化/入库的图数量（成本上限）
FIGURE_MAX_PER_DOC=20
# VLM 调用失败后的重试次数
FIGURE_VLM_RETRIES=1
