# ============================================================
# 知研 KnowResearch — 环境变量模板
# 作用：列出所有需要的环境变量及其说明
# 用法：复制为 .env 后填入真实值
# 安全：此文件提交 git；.env 已被 .gitignore 排除，永不提交
# ============================================================

# ---- LLM（大语言模型）----
# DeepSeek API：生成与问答
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- VLM（视觉语言模型）----
# 作用：PDF 图表/图片转结构化文字
# 当前模型：qwen3.8-omni-flash（多模态，文本+视觉一体）
VLM_API_KEY=your-qwen-vl-api-key-here
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-omni-flash

# ---- Embedding（文本向量化）----
# 本地模型目录，首次运行自动下载到该路径
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
EMBEDDING_MODEL_DIR=./models/embedding
EMBEDDING_DIMENSION=768

# ---- Reranker（重排序）----
# 本地模型目录，首次运行自动下载到该路径
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_MODEL_DIR=./models/reranker

# ---- 数据目录 ----
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INDEX_DIR=./data/index

# ---- 存储（MVP 阶段用 SQLite + 本地文件）----
DATABASE_URL=sqlite:///./data/knowresearch.db
POSTGRES_URL=postgresql+psycopg2://knowresearch:knowresearch@localhost:5432/knowresearch
FILE_STORAGE_DIR=./data/files

# ---- Redis（短期记忆 / 工作记忆热状态）----
REDIS_URL=redis://localhost:6379/0

# ---- PostgreSQL / Redis 容器（P1 Docker Compose）----
POSTGRES_DB=knowresearch
POSTGRES_USER=knowresearch
POSTGRES_PASSWORD=knowresearch
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- 演示模式 ----
# true 时使用 Mock Embedding / Reranker 和本地 Demo LLM，不依赖 GPU / API Key
DEMO_MODE=false
